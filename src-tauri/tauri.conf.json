{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Terminal",
  "version": "0.1.0",
  "identifier": "com.casperhk.ai-terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo run --bin ai-terminal",
    "beforeBuildCommand": "cargo build --release --bin ai-terminal"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AI Terminal",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
